# Per-host secrets. Copy to secrets/<hostname>.yaml, edit, then encrypt:
#
#   age -e -R ~/.ssh/id_ed25519.pub -R <host-ssh-key>.pub \
#     -o secrets/<hostname>.yaml.age secrets/<hostname>.yaml
#
# To decrypt for editing:
#   age -d -i ~/.ssh/id_ed25519 secrets/<hostname>.yaml.age > secrets/<hostname>.yaml
#
# Only .age files are committed. Plaintext YAML is gitignored.

8x8-keys:
  app-id: "vpaas-magic-cookie-your-app-id-here"
  key-id: "vpaas-magic-cookie-your-app-id-here/your-key-id"
  private-key: |
    -----BEGIN PRIVATE KEY-----
    your RSA private key here
    -----END PRIVATE KEY-----
  public-key: |
    -----BEGIN PUBLIC KEY-----
    your RSA public key here
    -----END PUBLIC KEY-----

recording:
  webdav:
    url: "https://nextcloud.example.com/remote.php/dav/files/username"
    user: "username"
    password: "app-password-from-nextcloud"
    # path is in config/defaults.yaml; override here only if needed.
  webhook-token: "random-token-matching-8x8-console"
  cloudflare:
    api-token: "your-cloudflare-stream-edit-token"
    account-id: "your-32-char-cloudflare-account-id"
    stream-customer-code: "your-cf-customer-code"
  # smtp: future SMTP credentials for email notifications
  # smtp:
  #   host: ""
  #   port: 587
  #   user: ""
  #   pass: ""

moderator-auth:
  enabled: false
  magic-link-ttl: 15m
  moderator-jwt-ttl: 2h
  signing-key: "random-secret-used-to-sign-magic-links"
  from-email: "meet@example.com"
  smtp:
    host: "smtp.resend.com"
    port: 587
    user: "resend"
    pass: "resend-api-key"
  rooms:
    workshop-april:
      moderators:
        - moderator@example.com
